<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Iniciar sesión - Panel de Pedidos</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; font-family: -apple-system, sans-serif; }
    .login-box { width: 300px; display: flex; flex-direction: column; gap: 12px; }
    .login-box input { padding: 10px 12px; font-size: 14px; border: 1px solid #b7b7b7; border-radius: 4px; }
    .login-box button { padding: 10px 12px; font-size: 14px; font-weight: 600; background: #1c4ed8; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    .error { color: #d82c0d; font-size: 13px; }
  </style>
</head>
<body>
  <form class="login-box" method="POST" action="/login">
    <h2>Iniciar sesión</h2>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <input type="text" name="username" placeholder="Usuario" autocomplete="username" required>
    <input type="password" name="password" placeholder="Contraseña" autocomplete="current-password" required>
    <button type="submit">Ingresar</button>
  </form>
</body>
</html>
